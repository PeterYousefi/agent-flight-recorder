      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(afr_execution_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{status}}"
