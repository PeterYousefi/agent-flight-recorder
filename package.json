{
  "name": "agent-flight-recorder",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first execution control plane for observable, replayable, cost-aware AI agent workloads",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm --recursive run build",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --recursive run test",
    "test:unit": "pnpm --recursive run test:unit",
    "test:integration": "pnpm --recursive run test:integration",
    "clean": "pnpm --recursive run clean"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3"
  }
}
