{
  "name": "@afr/api",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify REST API — execution management, idempotency, queue publish",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run src/api.integration.test.ts",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "lint": "eslint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "dependencies": {
    "@afr/adapters": "workspace:*",
    "@afr/application": "workspace:*",
    "@afr/domain": "workspace:*",
    "@afr/observability": "workspace:*",
    "@afr/persistence": "workspace:*",
    "@afr/providers": "workspace:*",
    "@afr/runtime": "workspace:*",
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.5",
    "@fastify/swagger": "9.9.1",
    "@fastify/swagger-ui": "6.1.1",
    "fastify": "5.12.5",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@prisma/client": "6.19.3",
    "@types/node": "22.15.29",
    "@vitest/coverage-v8": "5.0.3",
    "tsx": "4.19.4",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
