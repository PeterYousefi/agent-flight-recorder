{
  "name": "@afr/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Async execution worker \u2014 queue consumer, state machine driver, provider invocation",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "lint": "eslint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "dependencies": {
    "@afr/domain": "workspace:*",
    "@afr/observability": "workspace:*",
    "@afr/providers": "workspace:*",
    "@afr/application": "workspace:*",
    "@afr/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.15.29",
    "@vitest/coverage-v8": "5.0.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
