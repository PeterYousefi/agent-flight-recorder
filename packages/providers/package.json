{
  "name": "@afr/providers",
  "version": "0.1.0",
  "private": true,
  "description": "ExecutionProvider implementations: MockProvider and SapiomProvider",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "echo 'No integration tests in providers package'",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "lint": "eslint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "dependencies": {
    "@afr/domain": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
