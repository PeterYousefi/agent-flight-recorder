{
  "name": "@afr/persistence",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema and migrations for Agent Flight Recorder persistence",
  "type": "module",
  "scripts": {
    "build": "prisma generate",
    "typecheck": "DATABASE_URL=postgresql://localhost:5432/placeholder prisma validate",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "lint": "eslint prisma tests",
    "format": "prettier --write prisma tests package.json",
    "format:check": "prettier --check prisma tests package.json",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "6.17.1"
  },
  "devDependencies": {
    "@types/node": "22.15.29",
    "prisma": "6.17.1",
    "vitest": "5.0.3"
  }
}
