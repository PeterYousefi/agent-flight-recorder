# Optional configuration reference. pnpm demo does not load .env or require keys.
# Copy only the settings you need into an ignored .env and export them explicitly
# when starting API/worker separately. Keep real credentials out of Git.
API_PORT=3000
WORKER_CONCURRENCY=5
VITE_API_BASE_URL=http://localhost:3000
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Local runtime has emulator defaults; these are placeholders, not credentials.
# DATABASE_URL=postgresql://<user>:<password>@localhost:5434/<database>
# AZURE_SERVICE_BUS_CONNECTION_STRING=<local-emulator-connection-string>
# AZURE_STORAGE_CONNECTION_STRING=<local-azurite-connection-string>

# Optional Sapiom Router chat completions. Normal demos/tests never call it.
SAPIOM_ENABLED=false
RUN_SAPIOM_INTEGRATION_TESTS=false
# SAPIOM_API_KEY=<your-application-api-key>
# SAPIOM_MODEL=<your-model-alias>

# Azure provisioning is never part of local startup, tests or CI.
ALLOW_AZURE_DEPLOY=false
