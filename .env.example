# Agent Flight Recorder — Environment Variables
#
# Copy this file to .env and fill in values for local development.
# .env is gitignored. Never commit real secrets.
#
# For local development, most defaults here work with docker compose up -d.

# ─────────────────────────────────────────────
# API Service
# ─────────────────────────────────────────────
NODE_ENV=development
API_PORT=3000
API_HOST=0.0.0.0
LOG_LEVEL=info

# ─────────────────────────────────────────────
# Database (PostgreSQL)
# Local: matches docker-compose.yml postgres service
# Azure: Azure Database for PostgreSQL Flexible Server connection string
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://afr_user:afr_password@localhost:5434/agent_flight_recorder

# ─────────────────────────────────────────────
# Message Queue (Azure Service Bus)
# Local: Azure Service Bus emulator (docker-compose)
# Azure: Real Service Bus namespace connection string
# ─────────────────────────────────────────────
AZURE_SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://servicebus-emulator;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;
AZURE_SERVICE_BUS_QUEUE_NAME=executions

# ─────────────────────────────────────────────
# Artifact Storage (Azure Blob Storage)
# Local: Azurite emulator (docker-compose)
# Azure: Real storage account connection string
# ─────────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
AZURE_STORAGE_CONTAINER_NAME=execution-artifacts

# ─────────────────────────────────────────────
# OpenTelemetry
# Local: OTel Collector in docker-compose
# ─────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=agent-flight-recorder
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local

# ─────────────────────────────────────────────
# Sapiom Integration (optional)
# Leave unset to use MockProvider automatically — no Sapiom account required.
# Set to use real Sapiom tool calls via @sapiom/tools.
# ─────────────────────────────────────────────
# SAPIOM_API_KEY=your-sapiom-api-key-here

# ─────────────────────────────────────────────
# Worker Configuration
# ─────────────────────────────────────────────
WORKER_CONCURRENCY=5
WORKER_MESSAGE_LOCK_DURATION_SECONDS=300

# ─────────────────────────────────────────────
# Web Dashboard
# ─────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3000

# ─────────────────────────────────────────────
# Azure Deployment Guard
# This MUST be explicitly set to "true" to allow any Azure resource provisioning.
# Never set this in CI or normal development.
# ─────────────────────────────────────────────
ALLOW_AZURE_DEPLOY=false
